APP_NAME="CR Backend - Historias Clinicas"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Mexico_City

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12
HASH_DRIVER=argon2id

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# En Docker, DB_HOST debe ser el nombre del servicio "db" (docker-compose.yml).
# En local (sin Docker), usa 127.0.0.1.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=cr_backend
DB_USERNAME=cr_backend
DB_PASSWORD=change_this_password

# Puertos publicados al host por docker-compose
APP_PORT=8080
DB_FORWARD_PORT=5432

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@crm-colima.mx"
MAIL_FROM_NAME="${APP_NAME}"

# Minutos de vida del token Bearer (Sanctum) emitido en /api/v1/auth/login. 480 = 8 horas (una jornada).
SANCTUM_TOKEN_EXPIRATION_MINUTES=480

# Origenes permitidos para CORS, separados por coma (el/los dominios del frontend Next.js).
CORS_ALLOWED_ORIGINS=http://localhost:3000
